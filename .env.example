# ── App ──────────────────────────────────────────────────────────────
APP_NAME="দিনসাথী"
APP_ENV=local                 # local | staging | production
APP_DEBUG=true                # MUST be false in production
APP_URL=http://localhost:8000
APP_TIMEZONE_DISPLAY=Asia/Dhaka
APP_LOCALE=bn

SUPPORT_EMAIL=

# 32 random bytes, base64. Generate:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
HASH_PEPPER=

# ── Database ─────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dinsathi
DB_USER=dinsathi_app
DB_PASS=
DB_CHARSET=utf8mb4

# Migration credentials (server only — the app user above has no DDL rights)
DB_MIGRATE_USER=
DB_MIGRATE_PASS=

# ── BDApps (carrier billing) ─────────────────────────────────────────
SUBSCRIPTION_GATEWAY=mock     # mock | bdapps   (mock is BLOCKED when APP_ENV=production)
BDAPPS_API_BASE=
BDAPPS_CLIENT_ID=
BDAPPS_CLIENT_SECRET=
BDAPPS_DAILY_AMOUNT=2.78       # base "Planner" plan — required for the app itself, no free tier
BDAPPS_SMS_DAILY_AMOUNT=1.00   # "SMS Reminder" add-on — separate from Planner, priced apart
BDAPPS_SHORTCODE=16216
BDAPPS_STOP_KEYWORD=STOP

# ── SMS reminders ────────────────────────────────────────────────────
SMS_GATEWAY=mock              # mock | provider
SMS_PROVIDER_API_BASE=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=DinSathi

# ── Web Push (VAPID) ─────────────────────────────────────────────────
PUSH_GATEWAY=mock             # mock | webpush (webpush crypto needs review before use — see docs/FEATURES.md)
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:support@dinsathi.example.com

# ── OTP ──────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=60

# ── Security ─────────────────────────────────────────────────────────
SESSION_LIFETIME_MIN=43200
SESSION_ABSOLUTE_DAYS=30
SESSION_COOKIE_NAME=dinsathi_sid
SESSION_SECURE=true           # false only on plain-http localhost
TRUSTED_PROXIES=
ADMIN_IP_ALLOWLIST=

# ── Quiet hours / recurrence ─────────────────────────────────────────
QUIET_HOURS_START=22:00:00
QUIET_HOURS_END=07:00:00
RECURRENCE_HORIZON_DAYS=30

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info
