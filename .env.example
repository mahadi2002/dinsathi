# ── App ──────────────────────────────────────────────────────────────
APP_NAME="দিনসাথী"
APP_ENV=local                 # local | staging | production
APP_DEBUG=true                # MUST be false in production
APP_URL=http://127.0.0.1:8030
APP_TIMEZONE_DISPLAY=Asia/Dhaka
APP_LOCALE=bn

# 32 random bytes, base64. Generate:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
HASH_PEPPER=

# ── Database (MySQL) ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dinsathi
DB_USER=dinsathi_app
DB_PASS=

# Migration credentials (server only — the app user above has no DDL rights)
DB_MIGRATE_USER=
DB_MIGRATE_PASS=

# ── Web Push (VAPID) ─────────────────────────────────────────────────
PUSH_GATEWAY=mock             # mock | webpush (webpush crypto needs review before use — see TODO.md)
WEBPUSH_VAPID_PUBLIC_KEY=

# ── Password reset ──────────────────────────────────────────────────
PASSWORD_RESET_TTL_SECONDS=3600

# ── Security ─────────────────────────────────────────────────────────
SESSION_LIFETIME_MIN=43200
SESSION_ABSOLUTE_DAYS=30
SESSION_COOKIE_NAME=dinsathi_sid
SESSION_SECURE=true           # false only on plain-http localhost
TRUSTED_PROXIES=
ADMIN_IP_ALLOWLIST=

# ── Quiet hours / recurrence ─────────────────────────────────────────
QUIET_HOURS_START=22:00:00
QUIET_HOURS_END=07:00:00
RECURRENCE_HORIZON_DAYS=30

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info
